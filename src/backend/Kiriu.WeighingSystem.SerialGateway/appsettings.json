{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SerialSettings": {
    "PortName": "COM4",
    "BaudRate": 9600,
    "DataBits": 8,
    "Parity": "None",
    "StopBits": "One",
    "ReadTimeoutMs": 2000,
    "WriteTimeoutMs": 1000,
    "Unit": "kg"
  },
  "ServiceHost": {
    "Urls": "http://0.0.0.0:5080"
  }
}
